[Unit]
Description=ESC Chinese public learning service
After=network.target
[Service]
Type=simple
User=chinese-studio
Group=chinese-studio
WorkingDirectory=/srv/chinese-studio/current
EnvironmentFile=/etc/chinese-studio.env
ExecStart=/opt/chinese-node/bin/node server/index.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chinese-studio
UMask=0077
[Install]
WantedBy=multi-user.target
