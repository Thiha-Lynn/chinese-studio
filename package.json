{
  "name": "chinese-studio",
  "version": "1.2.4",
  "description": "ESC Chinese Language Training Center — lessons and offline practice",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "start": "node server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "dev:server": "tsx watch server/index.ts",
    "test:e2e": "playwright test",
    "release:portable": "node scripts/package-release.mjs",
    "format": "prettier --write src server tests scripts docs *.md",
    "native:sync": "npm run build && cap sync android",
    "build:desktop": "npm run build && npm ci --prefix native/desktop && npm run pack --prefix native/desktop --",
    "build:android": "npm run native:sync && cd android && ./gradlew assembleDebug",
    "check:release": "node scripts/check-release.mjs"
  },
  "keywords": [],
  "author": "Thiha-Lynn and contributors",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "hanzi-writer": "^3.7.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.46.0",
    "openid-client": "^6.8.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "hanzi-writer-data": "^2.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Thiha-Lynn/chinese-studio.git"
  },
  "homepage": "https://chinese.ztvmm.live",
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
